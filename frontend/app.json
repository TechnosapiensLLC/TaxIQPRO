{
  "expo": {
    "name": "TaxIQ Pro",
    "slug": "taxiq-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taxiqpro",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan receipts to track expenses automatically",
        "NSLocationWhenInUseUsageDescription": "Track mileage for tax deductions",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Auto-detect trips while driving",
        "NSPhotoLibraryUsageDescription": "Upload receipt photos from your gallery",
        "NSMotionUsageDescription": "Detect vehicle motion for automatic trip logging",
        "NSFaceIDUsageDescription": "Secure login with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan receipts to track expenses automatically"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Track mileage for tax deductions",
          "locationAlwaysAndWhenInUsePermission": "Auto-detect trips while driving"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
